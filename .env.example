# GUS API DBW (opcjonalny klucz zwiększający limity do 10 req/s i 50 000 req/7 dni)
GUS_DBW_API_KEY=
GUS_DBW_BASE_URL=https://api-dbw.stat.gov.pl/api/1.1.0

# API NBP (publiczne, bez klucza)
NBP_API_BASE_URL=https://api.nbp.pl/api/exchangerates

# PostgreSQL 16 (Docker / lokalnie)
POSTGRES_USER=tme_user
POSTGRES_PASSWORD=tme_password_change_me
POSTGRES_DB=tme_trade_pulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tme_user:tme_password_change_me@localhost:5432/tme_trade_pulse

# Automatyzacja / Alerting (opcjonalny webhook MS Power Automate)
PA_WEBHOOK_URL=

# Airflow (Docker Compose)
AIRFLOW_UID=50000

# === 1. GUS API DBW i NBP ===
# Opcjonalny darmowy klucz API DBW (https://api.stat.gov.pl/) – zwiększa limit do 10 req/s i 50 000 req/7 dni
GUS_DBW_API_KEY=
GUS_DBW_BASE_URL=https://api-dbw.stat.gov.pl/api/1.1.0
NBP_API_BASE_URL=https://api.nbp.pl/api/exchangerates

# === 2. Supabase Free Tier – PostgreSQL 16 (warstwy Silver: ref/staging i Gold: mart) ===
# Format: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# === 3. Supabase Free Tier – S3-Compatible Storage (warstwa Bronze: surowe .json.gz) ===
# Project Settings -> Storage -> S3 Connection / S3 Access Keys
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=gus-bronze

# === 4. Automatyzacja / Alerting (opcjonalny webhook MS Power Automate) ===
PA_WEBHOOK_URL=

